# Copy to .env locally. Do not commit secrets.
# No paid credentials are required for offline or NHL/MoneyPuck public paths.

# The Odds API (optional). Historical odds endpoints require a paid plan.
# Docs: https://the-odds-api.com/liveapi/guides/v4/
ODDS_API_KEY=

# Optional override of the repository root when running outside the checkout.
NHL_RESEARCH_ROOT=

# User-Agent used for polite public HTTP requests.
NHL_RESEARCH_USER_AGENT=nhl-research/0.1 (non-commercial research)
